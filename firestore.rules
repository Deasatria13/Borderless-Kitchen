rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // menuItems: siapa saja boleh baca (ditampilkan di landing page),
    // hanya admin (login via CMS) yang boleh tulis.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // orders: siapa saja boleh CREATE (submit order dari landing page),
    // tapi TIDAK boleh read/update/delete dari publik (biar data customer aman).
    // hanya admin yang login lewat CMS yang boleh baca/ubah.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'address', 'phone', 'items', 'total'])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.address is string
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0;
      allow read, update, delete: if request.auth != null;
    }
  }
}
